# ====================================================================
# AMAP Whisper Model Prefetch Image
#
# Builds the local faster-whisper tiny (multilingual, EN+HI) model that the
# backend resolves from backend/.whisper_cache/tiny at runtime.
#
# The runtime backend image (Dockerfile.backend) stays slim and never needs
# torch: this image carries the conversion tooling once, and docker-compose
# copies the finished model into a shared named volume mounted at
# /app/backend/.whisper_cache in the backend container.
#
# Requires network access to github.com + PyPI during the model build
# (mirrors scripts/prefetch_whisper_model.py, the same path CI uses).
# ====================================================================
FROM python:3.11-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /work

# Conversion tooling (PyPI only): CPU torch for the OpenAI->HF conversion,
# ctranslate2 ships ct2-transformers-converter.
RUN pip install --no-cache-dir \
    torch \
    --index-url https://download.pytorch.org/whl/cpu \
    && pip install --no-cache-dir transformers tiktoken faster-whisper

# REPO_ROOT is inferred from the script location (scripts/ -> /work), so the
# model is produced at /work/backend/.whisper_cache/tiny.
COPY scripts /work/scripts

# Default: build the model into the image layer so the service starts fast
# when no volume is mounted; compose overrides this to copy into the volume.
RUN python /work/scripts/prefetch_whisper_model.py
