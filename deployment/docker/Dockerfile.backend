# ====================================================================
# AMAP Backend Dockerfile (Production Multi-Stage Build)
# Python 3.11+ / FastAPI / Uvicorn
# ====================================================================

# Stage 1: Build Dependencies
FROM python:3.11-slim AS builder

WORKDIR /build

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

COPY backend/requirements.txt .
RUN pip install --no-cache-dir --user -r requirements.txt

# Stage 2: Runtime Image
FROM python:3.11-slim AS runtime

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 \
    curl \
    && rm -rf /var/lib/apt/lists/* \
    && useradd -u 1001 -m -s /bin/bash amapuser

# Copy installed wheels from builder
COPY --from=builder /root/.local /home/amapuser/.local

# Copy backend & AI application code
COPY --chown=amapuser:amapuser backend /app/backend
COPY --chown=amapuser:amapuser ai /app/ai

# Migration runner + seed + migration/seed SQL (used by the migrate service)
COPY --chown=amapuser:amapuser scripts /app/scripts
COPY --chown=amapuser:amapuser database /app/database

ENV PATH=/home/amapuser/.local/bin:$PATH \
    PYTHONPATH=/app/backend:/app \
    PYTHONUNBUFFERED=1 \
    PORT=8000

USER amapuser

EXPOSE 8000

HEALTHCHECK --interval=15s --timeout=5s --retries=3 --start-period=10s \
    CMD curl -f http://127.0.0.1:8000/api/v1/health || exit 1

WORKDIR /app/backend
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "4"]
