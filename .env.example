# ==============================================================================
# AMAP Environment Configuration Template
# Copy this file to .env and configure values for your deployment environment.
# DO NOT commit actual secrets or production credentials to source control.
# ==============================================================================

# Core Application Settings
ENVIRONMENT=development
APP_NAME=AMAP Backend
API_VERSION_PREFIX=/api/v1
LOG_LEVEL=INFO

# Database Connection (PostgreSQL)
POSTGRES_USER=amap_user
POSTGRES_PASSWORD=change_me_to_a_secure_password
POSTGRES_PORT=5432
DATABASE_URL=postgresql://amap_user:change_me_to_a_secure_password@localhost:5432/amap

# Cryptographic Authentication & JWT Settings
# In production, JWT_SECRET_KEY MUST be explicitly configured with a secure random key (min 32 characters).
JWT_SECRET_KEY=amap-dev-jwt-secret-key-change-in-production-mode
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Development-only Demo Accounts Fallback Flag
# MUST be false in production (enforced by startup validation)
ENABLE_DEV_DEMO_USERS=false

# Cross-Origin Resource Sharing (CORS)
# In production, CORS_ALLOWED_ORIGINS must be explicitly configured as comma-separated origins.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional Supabase Integration Settings
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
